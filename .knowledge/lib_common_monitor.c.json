{"is_source_file": true, "format": "C", "description": "This file implements a process and thread monitor for a Linux environment. It manages process lifecycle, handles signals, restores process states, tracks process counters to detect hangs or stalls, and provides crash handling and signal forwarding functionalities. It is part of a monitoring subsystem ensuring robustness and fault detection within a larger software system.", "external_files": ["log.h", "os.h", "os_time.h", "osa_assert.h", "monitor.h"], "external_methods": ["task_name_get", "task_name_set", "ticks", "ticks_t", "backtrace_dump"], "published": ["mon_checkin", "mon_start", "mon_process_wait", "mon_process_terminate", "mon_check_process", "mon_check_counter", "mon_counter_reset", "mon_install_parent_signals", "mon_reset_parent_signals", "mon_install_child_signals", "mon_sig_crash", "mon_sig_forward", "mon_sig_str"], "classes": [], "methods": [{"name": "void mon_start(int argc,char * argv[])", "description": "Initializes and starts the monitor process, forks a child process, manages process restarts and signal handling.", "scope": "", "scopeKind": ""}, {"name": "bool mon_process_wait(pid_t child,ticks_t timeout)", "description": "Waits for a specified process to terminate or timeout, reaping it if necessary.", "scope": "", "scopeKind": ""}, {"name": "void mon_process_terminate(pid_t child)", "description": "Attempts to terminate a process gracefully with SIGTERM, and forcefully with SIGKILL if needed.", "scope": "", "scopeKind": ""}, {"name": "bool mon_check_process(pid_t child,int * exit_status)", "description": "Checks whether a child process is still running and retrieves its exit status or restart signal.", "scope": "", "scopeKind": ""}, {"name": "bool mon_check_counter(pid_t child,int * exit_status)", "description": "Checks counters associated with monitored threads/processes to detect hangs or stalls, potentially aborting stuck threads.", "scope": "", "scopeKind": ""}, {"name": "void mon_counter_reset(void)", "description": "Initializes or resets the shared memory counters used to monitor process health.", "scope": "", "scopeKind": ""}, {"name": "void mon_install_parent_signals(void)", "description": "Sets signal handlers in the parent process for forwarding signals and managing process signals.", "scope": "", "scopeKind": ""}, {"name": "void mon_reset_parent_signals(void)", "description": "Restores default signal handlers in the parent process.", "scope": "", "scopeKind": ""}, {"name": "void mon_install_child_signals(void)", "description": "Sets crash handlers in the child process for generating core dumps and stack traces.", "scope": "", "scopeKind": ""}, {"name": "void mon_sig_crash(int signum)", "description": "Handles signals indicating a crash, logs a backtrace, and re-raises the signal for proper termination.", "scope": "", "scopeKind": ""}, {"name": "void mon_sig_forward(int signum)", "description": "Forwards signals like SIGINT and SIGTERM to the monitored child process.", "scope": "", "scopeKind": ""}, {"name": "void mon_sig_str(int signum,char * sigstr,size_t sigstr_sz)", "description": "Provides a textual description for a given signal number.", "scope": "", "scopeKind": ""}, {"name": "void mon_checkin(enum mon_cnt_id id,char * file,int line)", "description": "Increments a process or thread specific counter to signal operational health.", "scope": "", "scopeKind": ""}], "calls": ["waitpid", "kill", "sigaction", "snprintf", "strsignal", "raise", "usleep", "memset", "mmap", "assert", "strerror", "backtrace_dump", "getenv", "task_name_get", "task_name_set", "ticks", "syscall", "LOG"], "search-terms": ["monitor process restart", "shared memory counters", "signal handling Linux", "process health check", "crash dump handler", "thread hang detection", "signal forwarding child", "process monitoring system"], "state": 2, "file_id": 453, "knowledge_revision": 1406, "git_revision": "8baf68fb54a3e37187d065c5c24ed08a51433034", "ctags": [{"_type": "tag", "na